{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      { "include": "skills/**/*.md", "watchAssets": true },
      { "include": "skills/**/*.j2", "watchAssets": true },
      "**/*.html"
    ],
    "deleteOutDir": true
  }
}