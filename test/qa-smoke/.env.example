# Copy to .env and fill in real values to run this suite locally.
# In CI these are supplied by the qa-login-smoke job's env: block instead.

BASE_URL=https://qa.landtax.ymlgroup.com.au
LOGIN_EMAIL=pol.imbing@ymlgroup.com.au
LOGIN_PASSWORD=

# Optional — only needed to activate the tests that currently soft-skip.
# Each is a dedicated throwaway QA account; NEVER point these at a real user's account.
NEGATIVE_TEST_EMAIL=
NEGATIVE_TEST_PASSWORD=
ENUM_TEST_EMAIL=
LOCKOUT_TEST_EMAIL=
LOCKOUT_TEST_PASSWORD=
