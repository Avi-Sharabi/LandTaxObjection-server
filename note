for site_contraits database

CREATE TYPE constraint_type AS ENUM (
  'heritage_listing',
  'flood_zone_100yr',
  'bushfire_bal_restriction',
  'easement_or_right_of_way',
  'environmental_conservation_overlay',
  'zoning_planning_restriction',
  'access_restriction_landlocked',
  'contamination_remediation',
  'other'
);

CREATE TABLE site_constraints (
  id                UUID            PRIMARY KEY DEFAULT uuid_generate_v4(),
  dispute_id        UUID            NOT NULL REFERENCES dispute_cases(id) ON DELETE CASCADE,
  constraint_type   constraint_type NOT NULL,
  description       TEXT,
  legal_argument    TEXT,
  document_blob_url TEXT,
  created_at        TIMESTAMPTZ     NOT NULL DEFAULT NOW()
);




ALTER TABLE site_constraints
  ADD COLUMN IF NOT EXISTS doc_status        VARCHAR(30)  NOT NULL DEFAULT 'pending_documents',
  ADD COLUMN IF NOT EXISTS email_sent        BOOLEAN      NOT NULL DEFAULT FALSE,
  ADD COLUMN IF NOT EXISTS email_sent_at     TIMESTAMPTZ,
  ADD COLUMN IF NOT EXISTS email_retry_count SMALLINT     NOT NULL DEFAULT 0;

CREATE INDEX IF NOT EXISTS idx_site_constraints_doc_status
  ON site_constraints(doc_status);

CREATE UNIQUE INDEX IF NOT EXISTS uq_site_constraints_dispute_type
  ON site_constraints(dispute_id, constraint_type);